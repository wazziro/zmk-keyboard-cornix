/*
 * Cornix 用 keymap（Vial の cornix.vil から書き写したもの）
 *
 * SPDX-License-Identifier: MIT
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// 長押しの判定時間（Vial の Tapping term と同じ）
#define TAPPING_TERM 250

// Combo：押す時間の差の上限と、直前の打鍵からこれだけ空いていないと Combo を判定しない時間
#define COMBO_TIMEOUT 70
// Karabiner の薙刀式の同時押しの幅（90ms）と揃える。これより短いと、X→J のような同時押しで J が待たされて失敗する
#define COMBO_PRIOR_IDLE 90

// 短く押すと Tab、長押しで Ctrl
// 押している間にほかのキーを押したら、すぐ Ctrl と判定する（Ctrl+H を素早く打っても Tab にならないように）
&mt {
    flavor = "hold-preferred";
    tapping-term-ms = <TAPPING_TERM>;
};

// 短く押すと英数／かな、長押しでレイヤー
// 押している間にほかのキーを押したら、すぐレイヤーに切り替える（素早く数字や記号を打っても英数／かなにならないように）
&lt {
    flavor = "hold-preferred";
    tapping-term-ms = <TAPPING_TERM>;
};

/ {
    behaviors {
        // M：Ctrl を押しているときだけ Enter を送る（Ctrl は外して送る）
        ctrl_m_enter: ctrl_m_enter {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp M>, <&kp RET>;
            mods = <(MOD_LCTL|MOD_RCTL)>;
        };

        // 右ノブ：回すとスクロール
        scroll_enc: scroll_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // J＋K でかな
        combo_kana {
            bindings = <&kp LANG1>;
            key-positions = <19 20>;
            timeout-ms = <COMBO_TIMEOUT>;
            require-prior-idle-ms = <COMBO_PRIOR_IDLE>;
        };

        // D＋F で英数
        combo_eisu {
            bindings = <&kp LANG2>;
            key-positions = <15 16>;
            timeout-ms = <COMBO_TIMEOUT>;
            require-prior-idle-ms = <COMBO_PRIOR_IDLE>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp ESC               &kp Q                 &kp W                 &kp E                 &kp R                 &kp T                 &kp Y                 &kp U                 &kp I                 &kp O                 &kp P                 &kp BSLH
&mt LCTRL TAB         &kp A                 &kp S                 &kp D                 &kp F                 &kp G                 &kp H                 &kp J                 &kp K                 &kp L                 &kp SEMI              &kp MINUS
&kp LSHFT             &kp Z                 &kp X                 &kp C                 &kp V                 &kp B                 &kp C_MUTE            &none                 &kp N                 &ctrl_m_enter         &kp COMMA             &kp DOT               &kp FSLH              &kp RSHFT
&kp LALT              &kp LALT              &kp LC(LS(LG(N4)))    &kp LGUI              &lt 1 LANG2           &kp SPACE             &kp RET               &lt 2 LANG1           &kp TAB               &kp LC(LS(LA(LGUI)))  &kp RALT              &kp RCTRL
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &scroll_enc>;
        };

        lower_layer {
            display-name = "Lower";
            bindings = <
&trans            &kp N1            &kp N2            &kp N3            &kp N4            &kp N5            &kp N6            &kp N7            &kp N8            &kp N9            &kp N0            &kp BSPC
&trans            &kp LG(RBKT)      &kp LG(SPACE)     &kp LS(LG(LBKT))  &kp LS(LG(RBKT))  &kp TAB           &kp MINUS         &kp SQT           &kp GRAVE         &kp LBKT          &kp RBKT          &kp EQUAL
&trans            &none             &kp LG(W)         &none             &none             &none             &trans            &trans            &kp LS(MINUS)     &kp LS(SQT)       &kp LS(GRAVE)     &kp LS(LBKT)      &kp LS(RBKT)      &kp LS(EQUAL)
&trans            &trans            &trans            &trans            &trans            &trans            &mo 3             &mo 3             &trans            &trans            &trans            &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &scroll_enc>;
        };

        raise_layer {
            display-name = "Raise";
            bindings = <
&trans      &kp LS(N1)  &kp LS(N2)  &kp LS(N3)  &kp LS(N4)  &kp LS(N5)  &kp LS(N6)  &kp LS(N7)  &kp LS(N8)  &kp LS(N9)  &kp LS(N0)  &kp BSPC
&trans      &none       &none       &kp LALT    &kp LGUI    &none       &kp LEFT    &kp DOWN    &kp UP      &kp RIGHT   &none       &kp DEL
&trans      &none       &none       &none       &none       &none       &trans      &trans      &kp HOME    &kp RET     &kp PG_UP   &kp END     &none       &trans
&trans      &trans      &trans      &trans      &mo 3       &mo 3       &trans      &trans      &trans      &trans      &trans      &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &scroll_enc>;
        };

        adjust_layer {
            display-name = "Adjust";
            bindings = <
&bootloader   &kp F12       &kp F7        &kp F8        &kp F9        &none         &none         &none         &none         &none         &none         &bootloader
&bt BT_SEL 0  &kp F11       &kp F4        &kp F5        &kp F6        &none         &kp C_PP      &kp C_PREV    &kp C_VOL_DN  &kp C_VOL_UP  &kp C_NEXT    &none
&bt BT_SEL 1  &kp F10       &kp F1        &kp F2        &kp F3        &none         &none         &bt BT_CLR    &none         &none         &none         &none         &none         &none
&bt BT_SEL 2  &none         &none         &none         &trans        &none         &none         &trans        &none         &none         &none         &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &scroll_enc>;
        };
    };
};
